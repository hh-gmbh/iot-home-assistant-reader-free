{
  "name": "ha-reader-free",
  "version": "1.1.12",
  "private": true,
  "type": "module",
  "description": "Read-only Ansicht der Home-Assistant-Dashboards (Hammerherren GmbH)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "unsupported": "tsc -p tsconfig.json && node scripts/unsupported.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@mdi/js": "^7.4.47",
    "dompurify": "^3.5.0",
    "echarts": "^6.1.0",
    "fastify": "^5.12.8",
    "marked": "^18.2.1",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "@types/ssh2-sftp-client": "^9.0.6",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "ws": "^8.23.0"
  }
}
